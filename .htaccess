# ==============================================================================
# LEGISDATA (dipudata.com) — Configuración de Producción Grado Bancario & SEO
# Compatible con Apache 2.4 y LiteSpeed Enterprise (Hostinger)
# ==============================================================================

Options -Indexes -MultiViews
ServerSignature Off
DefaultLanguage es-AR
AddDefaultCharset UTF-8

# ------------------------------------------------------------------------------
# 1. CABECERAS DE SEGURIDAD GRADO BANCARIO (OWASP ASVS L2/L3)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header unset X-Powered-By
    Header always unset X-Powered-By

    # Caché inmutable para bundles compilados de Vite (JS/CSS con hash)
    <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# 2. COMPRESIÓN GZIP / DEFLATE PARA CORE WEB VITALS
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 3. BLOQUEO ESTRICTO DE ARCHIVOS SENSIBLES Y DIRECTORIOS INTERNOS (403)
# ------------------------------------------------------------------------------
<FilesMatch "(^\.|\.(sql|env|log|md|sh|bak|swp|lock)$|^package(-lock)?\.json$|^tsconfig(\.tsbuildinfo)?\.json$|^vite\.config\.ts$|^postcss\.config\.js$|^tailwind\.config\.js$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Bloquear acceso HTTP directo a directorios internos de backend, base de datos, cron y código fuente
    RewriteRule ^(cron|database|\.agent|\.git|node_modules|src|tests)(/|$) - [F,L,NC]

    # Bloquear acceso directo a librerías internas de /api (excepto api/index.php)
    RewriteRule ^api/(config|Security|Algorithms|credentials\.local)\.php$ - [F,L,NC]

    # --------------------------------------------------------------------------
    # 4. REGLAS DE ENRUTAMIENTO LIMPIO (SITEMAP, API REST Y SSR SPA ROUTER)
    # --------------------------------------------------------------------------

    # Sitemap XML dinámico
    RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]

    # Endpoints de la API RESTful (/api/* -> api/index.php)
    RewriteRule ^api/(.*)$ api/index.php [L,QSA]
    RewriteRule ^api$ api/index.php [L,QSA]

    # Si el archivo estático existe en /assets/*, /dist/assets/*, robots.txt o favicon.svg, servirlo directamente
    RewriteCond %{REQUEST_URI} ^/(assets|dist/assets)/ [OR]
    RewriteCond %{REQUEST_URI} ^/(robots\.txt|favicon\.svg|favicon\.ico)$
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Redirigir cualquier ruta de la SPA (/, /perfil/*, /match, etc.) al motor SSR index.php
    RewriteRule ^ index.php [L,QSA]
</IfModule>
