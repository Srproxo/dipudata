# DipuData — Apache 2.4 / LiteSpeed (Hostinger)
Options -Indexes -MultiViews
ServerSignature Off
DefaultLanguage es-AR
AddDefaultCharset UTF-8
DirectoryIndex mvc.php

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    Header always unset X-Powered-By
    # Los activos llevan ?v=<mtime>: pueden cachearse un año
    <FilesMatch "\.(css|svg|png|jpg|jpeg|webp|ico|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/xml application/json image/svg+xml
</IfModule>

# Nunca servir archivos internos
<FilesMatch "(^\.|\.(sql|env|log|md|sh|bak|swp|lock|py|json|csv)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Directorios internos: solo los lee PHP, nunca el navegador
    RewriteRule ^(app|storage|scripts|database|tests|\.git|\.agent)(/|$) - [F,L,NC]

    # API de solo lectura
    RewriteRule ^api(/.*)?$ api/index.php [L,QSA]

    # Archivos estáticos que existen
    RewriteCond %{REQUEST_URI} ^/(assets/|favicon\.svg|robots\.txt)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Todo lo demás lo resuelve el front controller
    RewriteRule ^ mvc.php [L,QSA]
</IfModule>
